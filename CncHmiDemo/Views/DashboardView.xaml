<UserControl x:Class="CncHmiDemo.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CncHmiDemo.Controls"
             Background="Transparent">
    <Grid Margin="18,16,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- KPI 卡片 -->
        <UniformGrid Grid.Row="0" Columns="6">
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="X 轴位置" Style="{StaticResource KpiLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding XPosition, StringFormat={}{0:F1}}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="mm" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="5,0,0,3" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Y 轴位置" Style="{StaticResource KpiLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding YPosition, StringFormat={}{0:F1}}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="mm" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="5,0,0,3" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="主轴转速" Style="{StaticResource KpiLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding SpindleRpm}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="rpm" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="5,0,0,3" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="切割速度" Style="{StaticResource KpiLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding CutSpeed, StringFormat={}{0:F0}}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="mm/min" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="5,0,0,3" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="激光功率" Style="{StaticResource KpiLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Power, StringFormat={}{0:F0}}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="%" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="5,0,0,3" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="任务进度" Style="{StaticResource KpiLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Progress}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="%" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="5,0,0,3" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 曲线 + 状态 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.85*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="实时曲线" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="切割速度 / 主轴转速 · 150 ms 采样" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <controls:RealtimeChart Grid.Row="1" Buffer="{Binding Chart}" Margin="0,10,0,0" MinHeight="220" />
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="设备状态" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding CurrentEndpoint}" Style="{StaticResource Muted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Background="{Binding StateBrush}" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="{Binding StateText}" Foreground="#04121F" FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding AlarmSummary}" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="当前任务" Style="{StaticResource KpiLabel}" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding CurrentJobText}" Foreground="{StaticResource TextBrush}"
                                   FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress}" Maximum="100"
                                     Margin="0,10,0,0" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Right" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="最近报警" Style="{StaticResource SectionTitle}" />
                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Alarms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="3" Padding="6,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="警告">
                                                                <Setter Property="Background" Value="{StaticResource WarnBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="严重">
                                                                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Level}" Foreground="#04121F" FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                       Foreground="{StaticResource TextBrush}" FontSize="11.5"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding TimeText}"
                                                       Foreground="{StaticResource FaintBrush}" FontSize="10.5"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
