<UserControl x:Class="CncHmiDemo.Views.JobView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="18,16,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="添加示例任务" Command="{Binding AddJobCommand}" Style="{StaticResource GhostButton}" />
            <Button Content="开始加工" Command="{Binding StartJobCommand}" Style="{StaticResource PrimaryButton}"
                    Margin="10,0,0,0" />
            <Button Content="暂停" Command="{Binding PauseJobCommand}" Style="{StaticResource GhostButton}"
                    Margin="10,0,0,0" />
            <Button Content="停止" Command="{Binding StopJobCommand}" Style="{StaticResource GhostButton}"
                    Margin="10,0,0,0" />
            <TextBlock Text="{Binding CurrentJobText}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Margin="18,0,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock Text="任务队列" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding Jobs.Count, StringFormat='共 {0} 个任务'}" Style="{StaticResource Muted}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding Jobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#1B2940" BorderThickness="0,0,0,1" Padding="10,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                                   FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Material}"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11.5"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="加工中">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="已完成">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent2Brush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ProgressBar Grid.Column="3" Style="{StaticResource ThinProgress}"
                                                     Value="{Binding Progress}" Maximum="100" VerticalAlignment="Center"
                                                     Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding Progress, StringFormat={}{0}%}"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="4" Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="当前任务" Style="{StaticResource KpiLabel}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding CurrentJobText}" Foreground="{StaticResource TextBrush}"
                                       FontSize="12" />
                            <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress}"
                                         Maximum="100" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
