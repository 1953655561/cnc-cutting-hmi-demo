<UserControl x:Class="CncHmiDemo.Views.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="18,16,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="报警与事件日志" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
            <Button Content="导出 CSV" Command="{Binding ExportAlarmsCommand}" Style="{StaticResource GhostButton}"
                    Margin="18,0,0,0" />
            <Button Content="清空记录" Command="{Binding ClearAlarmsCommand}" Style="{StaticResource GhostButton}"
                    Margin="10,0,0,0" />
            <TextBlock Text="报警自动落盘到本地 alarms.csv" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Margin="18,0,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="时间" Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="1" Text="级别" Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="2" Text="代码" Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="3" Text="描述" Style="{StaticResource Muted}" />
                </Grid>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding Alarms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#1B2940" BorderThickness="0,0,0,1" Padding="10,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource FaintBrush}"
                                                   FontSize="11" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="警告">
                                                            <Setter Property="Background" Value="{StaticResource WarnBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="严重">
                                                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Level}" Foreground="#04121F" FontSize="10"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Code}"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Message}"
                                                   Foreground="{StaticResource TextBrush}" FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
