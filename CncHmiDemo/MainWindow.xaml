<Window x:Class="CncHmiDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CncHmiDemo.Views"
        Title="数控切割设备上位机 Demo · C# / WPF"
        Width="1360" Height="860" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Text="CNC" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="数控切割设备上位机" Foreground="{StaticResource TextBrush}"
                                   FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="C# / WPF · Modbus TCP · 实时监控 Demo" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10.5" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding ConnectionBrush}" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" FontSize="12" Margin="0,0,14,0" />
                    <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="0,0,12,0" />
                    <RadioButton Content="TCP 模拟" IsChecked="{Binding IsTcpMode, Mode=TwoWay}"
                                 Style="{StaticResource ModeRadio}" />
                    <RadioButton Content="串口 RTU" IsChecked="{Binding IsSerialMode, Mode=TwoWay}"
                                 Style="{StaticResource ModeRadio}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding SerialPortName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Width="72" Margin="8,0,0,0" />
                    <Button Content="启动模拟设备" Command="{Binding StartSimulatorCommand}"
                            Style="{StaticResource GhostButton}" Margin="10,0,0,0" />
                    <Button Content="连接" Command="{Binding ConnectCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                    <Button Content="断开" Command="{Binding DisconnectCommand}"
                            Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 左侧导航 + 页面 -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                    Margin="6,8,0,0" TabStripPlacement="Left" ItemContainerStyle="{StaticResource NavTab}">
            <TabItem Header="状态监控">
                <views:DashboardView />
            </TabItem>
            <TabItem Header="参数配置">
                <views:ParameterView />
            </TabItem>
            <TabItem Header="任务调度">
                <views:JobView />
            </TabItem>
            <TabItem Header="报警日志">
                <views:AlarmView />
            </TabItem>
            <TabItem Header="路径预览">
                <views:PathView />
            </TabItem>
            <TabItem Header="通信日志">
                <views:CommunicationView />
            </TabItem>
        </TabControl>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusLeft}" Foreground="{StaticResource FaintBrush}"
                           FontSize="10.5" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StatusCenter}" Foreground="{StaticResource MutedBrush}"
                           FontSize="10.5" VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="20,0" />
                <TextBlock Grid.Column="2" Text="{Binding StatusRight}" Foreground="{StaticResource FaintBrush}"
                           FontSize="10.5" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
